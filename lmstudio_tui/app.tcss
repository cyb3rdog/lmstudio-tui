/* ── Tabs navigation bar ──────────────────────────────────────────────────── */

#nav-tabs {
    height: 3;
    background: $primary-darken-3;
    border-bottom: solid $primary-darken-2;
    dock: top;
    padding: 0 1;
}

#nav-tabs Tab {
    padding: 0 0;
}

/* ── Content area ─────────────────────────────────────────────────────────── */

#content-area {
    width: 1fr;
    height: 1fr;
    min-height: 0;
}

/* ── Footer ───────────────────────────────────────────────────────────────── */

Footer {
    height: 1;
    dock: bottom;
}

/* ── Focus rings ──────────────────────────────────────────────────────────── */

Button:focus {
    border: tall $primary;
    text-style: bold;
}

Input:focus {
    border: tall $primary;
}

ListView:focus-within {
    border-left: thick $primary;
}

/* ── Status colors ─────────────────────────────────────────────────────────── */

.status-connected    { color: $success; }
.status-connecting   { color: $warning; }
.status-disconnected { color: $text-muted; }
.status-error       { color: $error; }

/* ── Modals ───────────────────────────────────────────────────────────────── */

ModalScreen {
    align: center middle;
}

ModalScreen > Vertical {
    background: $surface;
    border: thick $primary;
    width: 90%;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    align: center middle;
}

OnboardingModal > Vertical {
    max-width: 90%;
    padding: 2 3;
}

OnboardingModal Label { margin-bottom: 1; }
OnboardingModal Input { margin-bottom: 1; }
OnboardingModal Horizontal { height: auto; align: center middle; margin-top: 1; }
OnboardingModal Button { margin: 0 1; }

ConfirmModal > Vertical {
    max-width: 90%;
}

ConfirmModal Label { margin-bottom: 1; }
ConfirmModal Horizontal { height: auto; align: center middle; }
ConfirmModal Button { margin: 0 1; }

ShortcutsModal > Vertical {
    max-width: 90%;
    max-height: 90%;
    padding: 1 2;
}

ShortcutsModal Label { margin-bottom: 1; }
ShortcutsModal .shortcuts-body {
    margin-bottom: 1;
    overflow-y: auto;
}
ShortcutsModal Horizontal { height: auto; align: center middle; margin-top: 1; }
ShortcutsModal Button { margin: 0 1; }

ServerFormModal > Vertical {
    max-width: 90%;
    padding: 1 2;
}

ServerFormModal Label { margin-top: 1; }
ServerFormModal Input { margin-bottom: 1; }
ServerFormModal Horizontal { height: auto; align: center middle; margin-top: 1; }
ServerFormModal Button { margin: 0 1; }

ModelLoadModal > Vertical {
    max-width: 90%;
    padding: 1 2;
}

ModelLoadModal Label { margin-top: 1; }
ModelLoadModal Horizontal { height: auto; align: center middle; margin-top: 1; }
ModelLoadModal Button { margin: 0 1; }

/* ── Toolbar stacking (portrait / narrow screens) ─────────────────────────── */

ModelManager #toolbar.stacked {
    layout: vertical;
    height: auto;
    padding-bottom: 0;
}

ModelManager #toolbar.stacked Button {
    width: 100%;
    margin: 0 0 1 0;
}

/* Chat toolbar stacks independently below CHAT_TOOLBAR_THRESHOLD (55 cols) */
ChatScreen #toolbar.stacked {
    layout: vertical;
    height: auto;
}

ChatScreen #toolbar.stacked #model-select {
    width: 1fr;
}

/* Settings panels stack vertically when width < NARROW_SCREEN_THRESHOLD (65) */
Settings #server-panel {
    min-width: 28;
}

/* ── Utility ─────────────────────────────────────────────────────────────── */

.-hidden {
    display: none;
}

/* ── Section heading styles (move presentation from Python markup) ────────── */

.section-title {
    text-style: bold;
    color: $primary;
}

.unloaded-title {
    color: $text-muted;
}

.summary-title {
    color: $primary;
    text-style: bold;
    height: 1;
}

/* ── ModelManager ────────────────────────────────────────────────────────── */

ModelManager {
    width: 1fr;
    height: 1fr;
}

ModelManager DataTable {
    height: 1fr;
    min-height: 0;
}

ModelManager #toolbar {
    width: 1fr;
    height: 4;
    padding: 0 1;
    background: $surface-darken-1;
    border-top: solid $primary-darken-3;
}

ModelManager #toolbar Button {
    margin: 0 1 0 0;
    width: 1fr;
}

/* ── ChatScreen ──────────────────────────────────────────────────────────── */

ChatScreen {
    width: 1fr;
    height: 1fr;
    min-height: 0;
}

ChatScreen #toolbar {
    height: auto;
    min-height: 3;
    padding: 0 1;
    background: $surface-darken-1;
    border-bottom: solid $primary-darken-3;
}

ChatScreen #toolbar-model-row {
    height: 3;
    width: 1fr;
}

ChatScreen #model-select {
    width: 1fr;
}

ChatScreen #toolbar-btns-row {
    height: 3;
    width: auto;
}

ChatScreen #btn-clear {
    margin: 0 1 0 0;
    width: auto;
    padding: 0 1;
}

ChatScreen #btn-stop {
    margin: 0;
    width: auto;
    padding: 0 1;
}

ChatScreen #chat-log {
    border: round $primary-darken-2;
    width: 1fr;
    max-width: 1fr;
    height: 1fr;
    min-height: 0;
    padding: 0 0 0 1;
    overflow-x: hidden;
}

ChatScreen #streaming-row {
    height: auto;
    min-height: 1;
    max-height: 4;
    padding: 0 1 0 1;
    background: $surface-darken-2;
    border-top: dashed $primary-darken-3;
    border-left: dashed $primary-darken-3;
    border-right: dashed $primary-darken-3;
}

ChatScreen #streaming-row.-hidden {
    display: none;
}

ChatScreen #streaming-label {
    width: 1fr;
    color: $text-muted;
}

ChatScreen #input-row {
    height: 4;
    padding: 0 1;
    background: $surface-darken-1;
    border-top: solid $primary-darken-3;
}

ChatScreen #chat-input {
    width: 1fr;
}

ChatScreen #btn-send {
    width: 8;
    margin: 0 0 0 1;
}

ChatScreen #empty-state {
    width: 1fr;
    height: 1fr;
    align: center middle;
    color: $text-muted;
    text-style: italic;
}

ChatScreen #empty-state.-hidden {
    display: none;
}

/* ── Dashboard ────────────────────────────────────────────────────────────── */

Dashboard {
    width: 1fr;
    height: 1fr;
    min-height: 0;
}

Dashboard #server-bar {
    height: 2;
    padding: 0 0;
    background: $surface-darken-1;
    border-bottom: solid $primary-darken-3;
}

Dashboard #models-scroll {
    height: 1fr;
    min-height: 0;
}

Dashboard #empty-placeholder {
    height: 1fr;
    align: center middle;
    color: $text-muted;
    text-style: italic;
}

Dashboard #unloaded-panel {
    height: 4;
    padding: 0 1 0 1;
    background: $surface-darken-2;
    border-top: solid $primary-darken-3;
}

Dashboard #unloaded-panel.-hidden {
    display: none;
}

Dashboard #unloaded-row {
    height: 4;
    align: left middle;
}

Dashboard #unloaded-title {
    color: $text-muted;
    width: 1fr;
    height: 3;
    content-align: left middle;
}

Dashboard #btn-manage-models {
    width: auto;
    min-width: 19;
}

/* ── LiveMonitor ──────────────────────────────────────────────────────────── */

LiveMonitor {
    width: 1fr;
    height: 1fr;
    min-height: 0;
}

LiveMonitor #toolbar {
    height: auto;
    min-height: 2;
    padding: 0 1;
    background: $surface-darken-1;
    border-bottom: solid $primary-darken-3;
}

LiveMonitor #panels-scroll {
    height: 1fr;
    min-height: 5;
}

LiveMonitor #recent-table {
    height: 1fr;
    min-height: 4;
}

LiveMonitor #recent-label {
    padding: 0 1;
    color: $text-muted;
    height: 1;
}

/* ── Settings ─────────────────────────────────────────────────────────────── */

Settings {
    width: 1fr;
    height: 1fr;
    min-height: 0;
}

Settings #layout {
    height: 1fr;
    min-height: 0;
}

Settings #server-panel {
    width: 36;
    min-width: 28;
    height: 1fr;
    min-height: 0;
    border-right: solid $primary-darken-3;
    padding: 0 1;
}

Settings #prefs-panel {
    width: 1fr;
    padding: 0 1;
}

Settings #layout.stacked {
    layout: vertical;
}

Settings #layout.stacked #server-panel {
    width: 1fr;
    height: auto;
    max-height: 15;
    border-right: none;
    border-bottom: solid $primary-darken-3;
}

Settings #layout.stacked #prefs-panel {
    width: 1fr;
}

Settings ListView {
    height: 1fr;
    min-height: 5;
    padding: 0 1;
    border: round $primary-darken-2;
}

Settings #btn-row {
    height: auto;
    width: 1fr;
}

Settings #btn-row Button {
    margin: 0 1 0 0;
    width: 1fr;
    min-width: 0;
}

Settings #action-row {
    height: auto;
    width: 1fr;
}

Settings #action-row Button {
    margin: 0 1 0 0;
    width: 1fr;
    min-width: 0;
}

Settings .pref-label {
    height: 1;
    color: $text-muted;
}

Settings Input {
    margin: 0;
}

Settings #poll-section,
Settings #timeout-section,
Settings #window-section,
Settings #export-section {
    height: auto;
    margin-bottom: 1;
}

Settings #save-row {
    height: auto;
    margin-top: 1;
}

Settings #save-row Button {
    margin: 0;
    width: 100%;
}

/* ── BenchmarkRunner ──────────────────────────────────────────────────────── */

/* Root: takes all available space — the results table needs every row. */
BenchmarkRunner {
    width: 1fr;
    height: 1fr;
    min-height: 0;
}

/* Config panel: bounded height so content that overflows can be scrolled.
   The ScrollableContainer handles internal scrolling when models + controls
   exceed the available space. Results table keeps its 1fr share below. */
BenchmarkRunner #config-panel {
    height: auto;
    max-height: 22;
    background: $surface-darken-1;
    border-bottom: solid $primary-darken-3;
    padding: 0 1;
}

BenchmarkRunner #model-list {
    height: auto;
    min-height: 5;
    max-height: 14;
    border: solid $primary-darken-3;
}

BenchmarkRunner #model-actions {
    height: auto;
}

BenchmarkRunner #model-actions Button {
    width: 1fr;
    margin: 0 1 0 0;
}

BenchmarkRunner #run-actions {
    height: auto;
}

BenchmarkRunner #run-actions Button {
    width: 1fr;
    margin: 0 1 0 0;
}

BenchmarkRunner #mode-row {
    height: auto;
}

BenchmarkRunner #mode-row Checkbox {
    margin: 0 1 0 0;
    width: auto;
}

BenchmarkRunner #params-row {
    height: auto;
}

BenchmarkRunner #params-row Label {
    width: auto;
    margin: 0 1 0 0;
}

BenchmarkRunner #params-row Input {
    width: 12;
}

/* Base styles for param-pair (non-stacked / normal width). */
BenchmarkRunner #params-row .param-pair {
    height: 3;
}

BenchmarkRunner #params-row .param-pair Label {
    width: auto;
    height: 3;
    content-align: left middle;
    margin: 0 1 0 0;
}

BenchmarkRunner #params-row .param-pair Input {
    width: 12;
}

/* Progressive disclosure: params panel collapses to a minimal bar when stacked.
   Users can still expand it via the "Params ▾" Collapsible widget. */
BenchmarkRunner #params-row.stacked {
    layout: vertical;
    height: auto;
}

BenchmarkRunner #params-row.stacked .param-pair {
    height: 3;
}

BenchmarkRunner #params-row.stacked .param-pair Label {
    width: 12;
    height: 3;
    content-align: right middle;
}

BenchmarkRunner #params-row.stacked .param-pair Input {
    width: 1fr;
}

BenchmarkRunner #progress-panel {
    height: 3;
    padding: 0 1;
    background: $surface-darken-1;
    border-bottom: solid $primary-darken-3;
    align: left middle;
}

BenchmarkRunner #progress-panel.-hidden {
    display: none;
}

BenchmarkRunner #prog-bar {
    width: 1fr;
}

BenchmarkRunner #prog-label {
    width: auto;
    margin-right: 1;
}

/* Summary panel: auto-height up to 8 rows, scrollable if content overflows. */
BenchmarkRunner #summary-panel {
    height: auto;
    max-height: 8;
    border-bottom: solid $primary-darken-3;
    padding: 0 1;
    background: $surface-darken-1;
    overflow-y: auto;
}

BenchmarkRunner #summary-content {
    height: auto;
    color: $text-muted;
}

BenchmarkRunner #results-table {
    height: 1fr;
    min-height: 0;
}

/* ── DownloadManager ──────────────────────────────────────────────────────── */

DownloadManager {
    width: 1fr;
    height: 1fr;
    min-height: 0;
    layout: vertical;
}

DownloadManager #search-bar {
    height: 4;
    padding: 0 1;
    background: $surface-darken-1;
    border-bottom: solid $primary-darken-3;
}

DownloadManager #search-bar Input {
    width: 1fr;
}

DownloadManager #search-bar Button {
    width: 10;
    margin-left: 1;
}

DownloadManager #status-bar {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    background: $surface-darken-2;
}

DownloadManager #results-table {
    height: 1fr;
}

/* action-bar and dl-bar occupy the same space; dl-bar overlays when active */
DownloadManager #action-bar {
    height: 4;
    padding: 0 1;
    background: $surface-darken-1;
    border-top: solid $primary-darken-3;
}

DownloadManager #action-bar.-hidden {
    display: none;
}

DownloadManager #selected-label {
    width: 1fr;
    height: 3;
    content-align: left middle;
    color: $text-muted;
}

DownloadManager #btn-download {
    width: auto;
}

DownloadManager #dl-bar {
    height: 4;
    padding: 0 1;
    background: $surface-darken-2;
    border-top: solid $primary-darken-3;
}

DownloadManager #dl-bar.-hidden {
    display: none;
}

DownloadManager #dl-label {
    width: auto;
    margin-right: 1;
}

DownloadManager #dl-progress {
    width: 1fr;
}

DownloadManager #btn-dl-cancel {
    width: auto;
    margin-left: 1;
}

/* ── Widgets ─────────────────────────────────────────────────────────────── */

/* ModelCard */
ModelCard {
    border: round $primary-darken-2;
    padding: 0 1;
    margin-bottom: 1;
    height: auto;
}

ModelCard .card-title {
    text-style: bold;
    color: $text;
    overflow: hidden;
}

ModelCard .card-meta {
    color: $text-muted;
    overflow: hidden;
}

ModelCard .card-params {
    color: $text-muted;
    overflow: hidden;
}

ModelCard Sparkline {
    height: 3;
    width: 1fr;
}

ModelCard ProgressBar {
    width: 1fr;
}

/* MetricPanel */
MetricPanel {
    border: round $primary-darken-2;
    padding: 0 1;
    margin-bottom: 1;
    height: auto;
}

MetricPanel .mp-title {
    text-style: bold;
}

MetricPanel Sparkline {
    height: 3;
    width: 1fr;
}

MetricPanel ProgressBar {
    width: 1fr;
}

/* StatusBadge */
StatusBadge {
    width: auto;
    height: 1;
}

/* ComparisonChart */
ComparisonChart {
    height: auto;
    min-height: 6;
}