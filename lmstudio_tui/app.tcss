/* ── App-level layout ─────────────────────────────────────────────────────── */

#main-layout {
    width: 1fr;
    height: 1fr;
}

/* ── Portrait mini-header ─────────────────────────────────────────────────── */

/* Shown only when sidebar is hidden (toggled by watch_sidebar_visible).
   Displays server status, current screen name, and number-key hints.   */
#mini-header {
    width: 100%;
    height: 2;
    background: $primary-darken-3;
    dock: top;
    display: none;
    padding: 0 1;
    color: $text;
    text-style: bold;
    border-bottom: solid $primary-darken-2;
}

/* ── Sidebar ──────────────────────────────────────────────────────────────── */

#sidebar {
    width: 22;
    height: 1fr;
    background: $surface-darken-1;
    border-right: solid $primary-darken-3;
}

#sidebar-title {
    padding: 1 1;
    text-style: bold;
    color: $primary;
    height: 3;
    border-bottom: solid $primary-darken-3;
}

#nav-list {
    height: 1fr;
    background: $surface-darken-1;
    border: none;
    padding: 0;
}

#nav-list > ListItem {
    padding: 0;
    background: $surface-darken-1;
}

#nav-list > ListItem:hover {
    background: $primary-darken-2;
}

#nav-list > ListItem.--highlight {
    background: $primary;
    color: $text;
    text-style: bold;
}

#nav-list:focus {
    border: none;
    outline: none;
}

/* ── Content area ─────────────────────────────────────────────────────────── */

#content-area {
    width: 1fr;
    height: 1fr;
}

/* ── Focus rings ──────────────────────────────────────────────────────────── */

Button:focus {
    border: tall $primary;
    text-style: bold;
}

DataTable:focus {
    border: tall $primary;
}

Select:focus {
    border: tall $primary;
}

SelectionList:focus {
    border: tall $primary;
}

Input:focus {
    border: tall $primary;
}

ListView:focus-within {
    border-left: thick $primary;
}

/* ── Status colors ────────────────────────────────────────────────────────── */

.status-connected    { color: $success; }
.status-connecting   { color: $warning; }
.status-disconnected { color: $text-muted; }
.status-error        { color: $error; }

/* ── Section headings ─────────────────────────────────────────────────────── */

.section-title {
    text-style: bold;
    color: $primary;
}

/* ── Modals ───────────────────────────────────────────────────────────────── */

ModalScreen > Vertical {
    background: $surface;
    border: thick $primary;
    width: 90%;
    max-width: 64;
    height: auto;
    padding: 1 2;
    align: center middle;
}

OnboardingModal > Vertical {
    max-width: 64;
}

ConfirmModal > Vertical {
    max-width: 50;
}

ShortcutsModal > Vertical {
    max-width: 58;
}

/* ── Toolbar stacking (portrait / narrow screens) ─────────────────────────── */

/* Model Manager: stack buttons below ~58 cols */
ModelManager #toolbar.stacked {
    layout: vertical;
    height: auto;
    padding-bottom: 1;
}

ModelManager #toolbar.stacked Button {
    width: 100%;
    margin: 0 0 1 0;
}

/* Chat toolbar stacks below ~60 cols */
ChatScreen #toolbar.stacked {
    layout: vertical;
    height: auto;
}

ChatScreen #toolbar.stacked #model-select {
    width: 1fr;
}

/* Settings panels stack vertically when width < 60 */
Settings #server-panel {
    min-width: 28;
}

/* LiveMonitor toolbar can become multiline when columns labeled */
LiveMonitor #toolbar.stacked {
    layout: vertical;
    height: auto;
}

/* ── DataTable column widths — compact on narrow screens ─────────────────── */

/* Utility: hide non-essential columns with .col-hidden class added by Python */
.col-narrow {
    display: none;
}

/* ── Utility ──────────────────────────────────────────────────────────────── */

.-hidden {
    display: none;
}
