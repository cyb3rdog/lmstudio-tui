/* ── App-level layout ─────────────────────────────────────────────────────── */

#main-layout {
    width: 1fr;
    height: 1fr;
}

/* Portrait mini header — visible only when sidebar is hidden.
   display is toggled programmatically in watch_sidebar_visible().
   Docked top so it sits above the main layout. */
#mini-header {
    width: 100%;
    height: 1;
    background: $surface-darken-1;
    dock: top;
    display: none;
    padding: 0 1;
    color: $text-muted;
}

/* ── Sidebar ──────────────────────────────────────────────────────────────── */

#sidebar {
    width: 22;
    height: 1fr;
    background: $surface-darken-1;
    border-right: solid $primary-darken-3;
}

#sidebar-title {
    padding: 1 1;
    text-style: bold;
    color: $primary;
    height: 3;
    border-bottom: solid $primary-darken-3;
}

#nav-list {
    height: 1fr;
    background: $surface-darken-1;
    border: none;
    padding: 0;
}

#nav-list > ListItem {
    padding: 0;
    background: $surface-darken-1;
}

#nav-list > ListItem:hover {
    background: $primary-darken-2;
}

#nav-list > ListItem.--highlight {
    background: $primary;
    color: $text;
    text-style: bold;
}

/* Sidebar nav focus ring — clear indicator when sidebar has keyboard focus */
#nav-list:focus {
    border: none;
    outline: none;
}

/* ── Content area ─────────────────────────────────────────────────────────── */

#content-area {
    width: 1fr;
    height: 1fr;
}

/* ── Focus rings — explicit visible focus indicator for interactive widgets ── */

/* Buttons: bold border when focused */
Button:focus {
    border: tall $primary;
    text-style: bold;
}

/* DataTable: highlighted border when the table itself has focus */
DataTable:focus {
    border: tall $primary;
}

/* Select dropdown: highlighted when focused */
Select:focus {
    border: tall $primary;
}

/* ListView: left accent when focused (sidebar nav uses this) */
ListView:focus-within {
    border-left: thick $primary;
}

/* ── Status colors (global) ───────────────────────────────────────────────── */

.status-connected    { color: $success; }
.status-connecting   { color: $warning; }
.status-disconnected { color: $text-muted; }
.status-error        { color: $error; }

/* ── Section headings ─────────────────────────────────────────────────────── */

.section-title {
    text-style: bold;
    color: $primary;
}

/* ── Modals — responsive sizing ───────────────────────────────────────────── */

/* Base: shrinks to fit on narrow screens */
ModalScreen > Vertical {
    background: $surface;
    border: thick $primary;
    width: 90%;
    max-width: 64;
    height: auto;
    padding: 1 2;
    align: center middle;
}

/* Onboarding wider on large screens */
OnboardingModal > Vertical {
    max-width: 64;
}

/* Confirm dialog is narrower */
ConfirmModal > Vertical {
    max-width: 50;
}

/* Shortcuts modal: readable width */
ShortcutsModal > Vertical {
    max-width: 58;
}

/* ── Toolbar stacking — portrait/narrow screen layout ────────────────────── */

/* Benchmark config stacks vertically on narrow screens via on_resize() */
BenchmarkRunner #config-row.stacked {
    layout: vertical;
    height: auto;
}

/* Chat toolbar stacks vertically on narrow screens via on_resize() */
ChatScreen #toolbar.stacked {
    layout: vertical;
    height: auto;
}

ChatScreen #toolbar.stacked #model-select {
    width: 1fr;
}

/* Settings panels stack vertically when width is tight */
Settings #server-panel {
    min-width: 28;
}

/* ── Utility ──────────────────────────────────────────────────────────────── */

.-hidden {
    display: none;
}
