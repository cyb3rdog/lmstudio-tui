/* ── App-level layout ─────────────────────────────────────────────────────── */

#main-layout {
    width: 1fr;
    height: 1fr;
}

/* ── Sidebar ──────────────────────────────────────────────────────────────── */

#sidebar {
    width: 22;
    height: 1fr;
    background: $surface-darken-1;
    border-right: solid $primary-darken-3;
}

#sidebar-title {
    padding: 1 1;
    text-style: bold;
    color: $primary;
    height: 3;
    border-bottom: solid $primary-darken-3;
}

#nav-list {
    height: 1fr;
    background: $surface-darken-1;
    border: none;
    padding: 0;
}

#nav-list > ListItem {
    padding: 0;
    background: $surface-darken-1;
}

#nav-list > ListItem:hover {
    background: $primary-darken-2;
}

#nav-list > ListItem.--highlight {
    background: $primary-darken-1;
    color: $text;
    text-style: bold;
}

/* ── Content area ─────────────────────────────────────────────────────────── */

#content-area {
    width: 1fr;
    height: 1fr;
}

/* ── Status colors (global) ───────────────────────────────────────────────── */

.status-connected    { color: $success; }
.status-connecting   { color: $warning; }
.status-disconnected { color: $text-muted; }
.status-error        { color: $error; }

/* ── Section headings ─────────────────────────────────────────────────────── */

.section-title {
    text-style: bold;
    color: $primary;
}

/* ── Modals — responsive sizing ───────────────────────────────────────────── */

/* Base modal dialog: shrinks to fit on narrow screens */
ModalScreen > Vertical {
    background: $surface;
    border: thick $primary;
    width: 90%;
    max-width: 64;
    height: auto;
    padding: 1 2;
    align: center middle;
}

/* Onboarding wider on large screens */
OnboardingModal > Vertical {
    max-width: 64;
}

/* Confirm dialog is narrower */
ConfirmModal > Vertical {
    max-width: 50;
}

/* ── Toolbar rows — wrap on narrow screens ────────────────────────────────── */

/* Benchmark config stacks vertically on narrow screens via on_resize() */
BenchmarkRunner #config-row.stacked {
    layout: vertical;
    height: auto;
}

/* Settings panels stack vertically when width is tight */
Settings #server-panel {
    min-width: 28;
}

/* ── Utility ──────────────────────────────────────────────────────────────── */

.-hidden {
    display: none;
}
